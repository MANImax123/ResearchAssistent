# Core
APP_ENV=dev
SECRET_KEY=change-me-to-a-random-string
JWT_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Postgres (pgvector)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=researchflow
POSTGRES_USER=researchflow
POSTGRES_PASSWORD=researchflow_dev_password

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=researchflow
# Host the browser uses to reach MinIO (presigned download URLs are signed for it)
MINIO_PUBLIC_ENDPOINT=localhost:9000

# Uploads
MAX_UPLOAD_MB=50

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password

# GROBID
GROBID_URL=http://grobid:8070

# LLM (provider: gemini | openai | fake). All model calls go through app/services/llm.py
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Main reasoning/generation model, and a cheaper one for extraction/classification
LLM_MODEL=gemini-3.8-flash
LLM_MODEL_FAST=gemini-3.5-flash-lite
# Used automatically when the main model is overloaded (503/504); leave empty to disable
LLM_MODEL_FALLBACK=gemini-3.5-flash-lite
# Embeddings (EMBEDDING_DIM must match the paper_chunks vector column)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536
# OpenAI alternative: LLM_PROVIDER=openai, LLM_MODEL=gpt-5.4, LLM_MODEL_FAST=gpt-5.4-mini,
#                     EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small

# Academic APIs
S2_API_KEY=
OPENALEX_EMAIL=
CROSSREF_EMAIL=
UNPAYWALL_EMAIL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
